data/
clips/
*.mp4
*.mov
*.avi
*.mkv
*.zip

# Generated event output from the detection pipeline (keep .gitkeep, ignore actual events)
events/*.jsonl

# SQLite DB
*.db

# Extracted frames (large, generated by calibrate.py)
data/_frames/

